// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // basic profile fields
  name   String?
  phone  String?
  city   String?
  bio    String?

  keys         Key[]
  sessions     Session[]
  listings     Listing[]
  comments     Comment[]
  commentLikes CommentLike[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Key {
  id             String  @id // es: "email:foo@bar.com"
  userId         String
  hashedPassword String?
  primary        Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Listing {
  id          String   @id @default(cuid())
  title       String
  description String

  // salvati come string
  animalType String
  status     String   @default("LOST")

  city       String?
  latitude   Float?
  longitude  Float?
  photos     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  comments Comment[]
  messages ContactMessage[]   // ⬅️ NUOVO: messaggi ricevuti per questo listing
}

model Comment {
  id        String   @id @default(cuid())
  listingId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes CommentLike[]

  @@index([listingId], map: "idx_comment_listing")
  @@index([userId], map: "idx_comment_user")
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId], name: "user_comment_unique")
  @@index([commentId])
  @@index([userId])
}

// ⬇️ NUOVO MODELLO
model ContactMessage {
  id        String   @id @default(cuid())
  listingId String
  name      String?
  email     String?
  phone     String?
  body      String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId], map: "idx_contact_message_listing")
}